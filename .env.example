# Telegram Bot Configuration
TG_BOT_TOKEN=your_bot_token_here
TG_API_ID=your_api_id_here
TG_API_HASH=your_api_hash_here
TG_PROXY_URL=socks5://user:pass@host:port

# LLM API Keys (at least one is required)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Remote Server for OCR/Translation (Kaggle/Colab ngrok/cloudflare URL)
# Example: https://xxxx.ngrok-free.app or https://xxxx.trycloudflare.com
REMOTE_SERVER_URL=

# Modal GPU inpainting (снимает нагрузку с локального CPU)
# Legacy персональный токен:
# MODAL_TOKEN_ID=ak-...
# MODAL_TOKEN_SECRET=as-...
# Новый формат workspace-ключей для вебхука/прокси (рекомендуется):
MODAL_KEY=wk-...
MODAL_SECRET=ws-...
# ID и URL приложения Modal (URL строится автоматически, если не задан):
# MODAL_APP_ID=workspace/manga-inpaint
# MODAL_APP_URL=https://...

# Optional: WebFandom tokens
WEBFANDOM_ACCESS_TOKEN=
WEBFANDOM_REFRESH_TOKEN=

# Optional: Data directory (defaults to cfg/)
# DATA_DIR=/app/data/config

# Web Translation Editor (http://localhost:8090/)
EDITOR_PORT=8090

# Web Dashboard (http://localhost:8091/)
DASHBOARD_PORT=8091

# Webhook URLs (comma-separated) for chapter-done/failed notifications
# WEBHOOK_URLS=https://example.com/hook1,https://example.com/hook2
